{% extends 'base.html.twig' %}

{% block title %}Détails du produit{% endblock %}

{% block body %}
<div class="container">
    <br>
    <h1>Détails du produit</h1>
    <br>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ product.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ product.name }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ product.description }}</td>
            </tr>
            <tr>
                <th>Prix</th>
                <td>{{ product.price }} €</td>
            </tr>
            <tr>
                <th>Stock</th>
                <td>
                    {% if product.stock > 0 %}
                        {{ product.stock }}
                    {% else %}
                        <span class="text-danger">Stock épuisé</span>
                    {% endif %}
                </td>
            </tr>
            <tr>
                <th>Sous-catégories</th>
                <td>
                    {% for subCategory in product.subCategories %}
                        <span class="badge bg-secondary">{{ subCategory.name }}</span>
                    {% else %}
                        <span class="text-muted">Aucune</span>
                    {% endfor %}
                </td>
            </tr>
            <tr>
                <th>Image</th>
                <td>
                    {% if product.image %}
                        <img src="{{ asset('uploads/images/' ~ product.image) }}" alt="{{ product.name }}" width="150" class="img-thumbnail">
                    {% else %}
                        <span class="text-muted">Aucune image</span>
                    {% endif %}
                </td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_product_stock_add_history', {'id': product.id}) }}">Afficher l'historique des ajouts au stock</a>
    <br><br>
    <a class="btn btn-outline-primary" href="{{ path('app_product_edit', {'id': product.id}) }}">Modifier</a>
    <br><br>
    {{ include('product/_delete_form.html.twig') }}
    <br>
    <a class="btn btn-dark" href="{{ path('app_product_index') }}">Retour</a>
</div>
{% endblock %}
